# Datos: solo se versionan los marcadores de posición, nunca los archivos.
data/*
!data/raw/
!data/processed/
!data/external/
data/raw/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Restos de descargas con credenciales (nunca deben subirse).
data/netrc.*
data/cookies.*
data/*-download.sh

backend/.venv/
backend/data/
data/raw/
data/processed/
.env
backend/*/**/.pytest_cache/

# Caché de Python y módulos generados (nunca deben subirse).
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
*.egg
pip-log.txt
pip-delete-this-directory.txt
.eggs/
dist/
build/
*.so
*.egg-link

*.env
